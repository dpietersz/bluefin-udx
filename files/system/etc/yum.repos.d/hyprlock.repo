[copr:copr.fedorainfracloud.org:lionheartp:Hyprland-hyprlock]
name=Copr repo for current hyprlock builds (package-scoped)
baseurl=https://download.copr.fedorainfracloud.org/results/lionheartp/Hyprland/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/lionheartp/Hyprland/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
# Hyprland is a broad multi-package project. Restrict it to hyprlock and the
# ABI-matched Hypr ecosystem libraries it requires; abandoned sibling apps
# such as noctalia-shell-v5 can never participate in dependency resolution.
includepkgs=hyprlock*,hyprgraphics*,hyprlang*,hyprutils*,hyprwayland-scanner*
