[rpmfusion-free-telegram]
name=RPM Fusion for Fedora $releasever - Free (Telegram only)
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-$releasever&arch=$basearch
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-free-fedora-2020
repo_gpgcheck=0
enabled=1
enabled_metadata=1
# Bluefin uses Negativo17 for multimedia packages. Expose only Telegram so
# RPM Fusion cannot replace FFmpeg, Mesa, or other multimedia dependencies.
includepkgs=telegram-desktop*

[rpmfusion-free-telegram-updates]
name=RPM Fusion for Fedora $releasever - Free Updates (Telegram only)
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-updates-released-$releasever&arch=$basearch
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-free-fedora-2020
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=telegram-desktop*
