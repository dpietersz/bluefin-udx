[copr:copr.fedorainfracloud.org:barsnick:non-fed-showmethekey]
name=Copr repo for current showmethekey builds (package-scoped)
baseurl=https://download.copr.fedorainfracloud.org/results/barsnick/non-fed/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/barsnick/non-fed/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
# barsnick/non-fed contains many unrelated packages. Never let this repo
# participate in dependency resolution beyond showmethekey itself.
includepkgs=showmethekey*
