[Unit]
Description=Rebuild and epoch-stamp the system fontconfig cache before the graphical session
Documentation=man:fc-cache(1)
# distrobox shares ~/.cache/fontconfig with the host while its /usr/share/fonts
# is different. 06-bluefin-host-font-dir-salt.conf isolates host system font
# cache keys from unsalted container keys at every cache format version.
#
# This unit rebuilds the writable /var cache and retains its composefs-friendly
# epoch stamp. The stamp is not the collision boundary; the directory salt is.
After=local-fs.target systemd-tmpfiles-setup.service
Before=display-manager.service
ConditionPathExists=/usr/bin/fc-cache
ConditionPathExists=/usr/libexec/bluefin-udx/fc-cache-boot.sh

[Service]
Type=oneshot
RemainAfterExit=yes
# Bounded so a hung fc-cache cannot sit in front of display-manager.service for
# the 90s default on every boot.
TimeoutStartSec=120
# Logic lives in a real script, not an inline `bash -c`: the previous one-liner
# nested three levels of quoting and was one edit away from silently breaking.
ExecStart=/usr/libexec/bluefin-udx/fc-cache-boot.sh

[Install]
WantedBy=multi-user.target
