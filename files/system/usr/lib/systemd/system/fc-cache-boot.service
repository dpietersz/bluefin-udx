[Unit]
Description=Rebuild the system fontconfig cache before the graphical session
Documentation=man:fc-cache(1)
# WHY (read before deleting): /usr/share/fonts presents an epoch (1970) mtime
# under ostree/composefs while every fontconfig cache that indexes it records a
# real mtime at build time, so fontconfig deems the cache stale and rescans
# /usr/share/fonts LIVE on every process start. When that rescan races font-dir
# churn at login (e.g. a distrobox host-font bind-mount as the niri session
# comes up), Chromium/Electron apps (Helium, teams-for-linux) lose the system
# sans-serif and cache a last-resort font for their whole session: monospace
# text + tofu/blank emoji. This unit rebuilds the system caches into the shared
# writable /var/cache/fontconfig (the first cachedir, see
# /etc/fonts/conf.d/05-bluefin-writable-cache.conf) EARLY — in a quiet namespace
# before the display manager and before any distrobox/user font churn — so the
# captured mtime stays stable and the cache validates for the rest of the
# session. GUI apps then read a valid cache instead of rescanning. Ordered
# Before=display-manager.service so no GUI session can start until it completes.
After=local-fs.target systemd-tmpfiles-setup.service
Before=display-manager.service
ConditionPathExists=/usr/bin/fc-cache

[Service]
Type=oneshot
RemainAfterExit=yes
# Belt-and-suspenders: the tmpfiles snippet creates this, but guarantee it
# exists even if tmpfiles ordering ever changes. fc-cache writes the system font
# caches to the first writable cachedir, which is /var/cache/fontconfig.
ExecStartPre=-/usr/bin/mkdir -p /var/cache/fontconfig
# --system-only: scan only system font dirs (skip per-user ~/.fonts, which the
# user-scope refresh-fontconfig-cache.service in dotfiles already handles and
# whose caches validate fine). --force: rebuild unconditionally — the entire bug
# is fontconfig mis-deciding a stale cache is fresh, so never trust its staleness
# check here. Costs ~1-2s at boot; runs before the DM, not on the login path.
ExecStart=/usr/bin/fc-cache --system-only --force

[Install]
WantedBy=multi-user.target
