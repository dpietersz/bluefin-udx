#!/usr/bin/python3
"""Line-delimited JSON bridge to greetd's framed Unix socket protocol."""

from collections import deque
import json
import os
import select
import socket
import struct
import sys
import time


MAX_INPUT = 64 * 1024
MAX_REPLY = 1024 * 1024
CONNECT_TIMEOUT = 5
DEFAULT_REPLY_TIMEOUT = 120.0
TOO_LONG = object()


class PeerClosedError(Exception):
    """The greetd peer closed its socket before a complete reply arrived."""


def write_line(message):
    try:
        line = json.dumps(message, ensure_ascii=True, separators=(",", ":")).encode("ascii") + b"\n"
        sys.stdout.buffer.write(line)
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        try:
            os.dup2(devnull, sys.stdout.fileno())
        finally:
            os.close(devnull)
        return False
    return True


def bridge_error(description):
    return write_line({"type": "error", "error_type": "bridge", "description": description})


def reply_timeout():
    try:
        timeout = float(os.environ.get("VITTA_GREETD_BRIDGE_TIMEOUT", DEFAULT_REPLY_TIMEOUT))
    except ValueError:
        return DEFAULT_REPLY_TIMEOUT
    return timeout if timeout > 0 else DEFAULT_REPLY_TIMEOUT


def take_frame(buffer):
    """Remove and return one complete frame body, or None when it is incomplete."""
    if len(buffer) < 4:
        return None
    (length,) = struct.unpack("=I", buffer[:4])
    if length > MAX_REPLY:
        raise ValueError("greetd reply is too large")
    end = 4 + length
    if len(buffer) < end:
        return None
    body = bytes(buffer[4:end])
    del buffer[:end]
    return body


def queue_lines(buffer, pending, discarding):
    """Move complete stdin lines to pending and discard one over-long line."""
    while buffer:
        if discarding:
            newline = buffer.find(b"\n")
            if newline < 0:
                buffer.clear()
                return True
            del buffer[: newline + 1]
            discarding = False
            continue

        newline = buffer.find(b"\n")
        if newline < 0:
            if len(buffer) > MAX_INPUT:
                pending.append(TOO_LONG)
                buffer.clear()
                return True
            return False
        if newline > MAX_INPUT:
            pending.append(TOO_LONG)
        else:
            pending.append(bytes(buffer[:newline]))
        del buffer[: newline + 1]
    return discarding


def fail(description):
    return 1 if bridge_error(description) else 0


def send_request(connection, line):
    try:
        request = json.loads(line.decode("utf-8"))
        if not isinstance(request, dict):
            raise ValueError
        payload = json.dumps(request, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    except (TypeError, UnicodeError, ValueError, json.JSONDecodeError):
        return False
    try:
        connection.sendall(struct.pack("=I", len(payload)) + payload)
    finally:
        del payload
    return True


def run():
    socket_path = os.environ.get("GREETD_SOCK")
    if not socket_path:
        return fail("GREETD_SOCK is not set")
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(CONNECT_TIMEOUT)
        connection.connect(socket_path)
        connection.settimeout(None)
    except OSError:
        connection.close()
        return fail("could not connect to greetd")

    input_buffer = bytearray()
    reply_buffer = bytearray()
    pending = deque()
    discarding = False
    stdin_eof = False
    outstanding = False
    deadline = None

    with connection:
        while True:
            if outstanding:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return fail("greetd did not answer in time")
                timeout = 0 if reply_buffer else remaining
            elif pending:
                timeout = 0
            elif stdin_eof:
                return 0
            else:
                timeout = None

            readable = [connection]
            if not stdin_eof:
                readable.append(0)
            readable, _, _ = select.select(readable, [], [], timeout)

            read_stdin_data = False
            # EOF wins while a request is outstanding: leave greetd immediately.
            if not stdin_eof and 0 in readable:
                chunk = os.read(0, 65536)
                if chunk:
                    read_stdin_data = True
                    input_buffer.extend(chunk)
                    discarding = queue_lines(input_buffer, pending, discarding)
                else:
                    stdin_eof = True
                    if outstanding:
                        return 0
                    # After EOF, finish complete queued lines in order. The final
                    # unterminated line is a line too, matching readline() at EOF.
                    if not discarding and input_buffer:
                        pending.append(bytes(input_buffer))
                    input_buffer.clear()

            if connection in readable:
                chunk = connection.recv(65536)
                if not chunk:
                    raise PeerClosedError
                reply_buffer.extend(chunk)

            if outstanding:
                body = take_frame(reply_buffer)
                if body is not None:
                    reply = json.loads(body.decode("utf-8"))
                    if not isinstance(reply, dict):
                        raise ValueError("greetd reply is not a JSON object")
                    outstanding = False
                    deadline = None
                    if not write_line(reply):
                        return 0

            if not read_stdin_data and not outstanding and pending:
                line = pending.popleft()
                if line is TOO_LONG:
                    if not bridge_error("input line is too long"):
                        return 0
                elif line:
                    try:
                        sent = send_request(connection, line)
                    except OSError:
                        return fail("greetd closed or sent an invalid reply")
                    if not sent:
                        if not bridge_error("input is not a JSON object"):
                            return 0
                    else:
                        outstanding = True
                        deadline = time.monotonic() + reply_timeout()


def main():
    try:
        return run()
    except BrokenPipeError:
        return 0
    except (PeerClosedError, OSError, UnicodeError, ValueError, json.JSONDecodeError):
        try:
            return fail("greetd closed or sent an invalid reply")
        except BrokenPipeError:
            return 0
    except Exception as error:
        try:
            return fail(type(error).__name__)
        except BrokenPipeError:
            return 0


if __name__ == "__main__":
    raise SystemExit(main())
