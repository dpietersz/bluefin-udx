#!/bin/bash
# vitta-greeter — greetd's default_session (see /etc/greetd/config.toml).
# Runs as the greetd user: cage gives the Quickshell greeter a fullscreen
# Wayland output; -s keeps VT switching available for recovery. -m last puts
# the greeter on one output only: the default (-m extend) spans every
# connected monitor, which on a docked laptop centres the card on the seam.
# -d makes cage answer xdg-decoration with server_side (it draws none): by
# default it tells clients to decorate themselves, and Qt then frames the
# greeter in its white title bar and 3 px edges inside the output.
set -euo pipefail

# greetd hands the greeter a minimal environment; Theme.qml resolves
# vitta-theme through PATH.
export PATH="${PATH:-/usr/local/bin:/usr/bin}:/usr/sbin"

# Keep Quickshell's config/cache/state in greetd's own home
# (/var/lib/greetd, created by greetd's tmpfiles.d), never in /.
GREETD_HOME=/var/lib/greetd
export XDG_CONFIG_HOME="$GREETD_HOME/.config"
export XDG_CACHE_HOME="$GREETD_HOME/.cache"
export XDG_STATE_HOME="$GREETD_HOME/.local/state"

# Pin cage only when a multi-GPU system identifies the panel-owning card. The
# helper is deliberately advisory: any failure or unexpected output leaves
# wlroots to select normally, so a broken helper cannot block the login path.
unset WLR_DRM_DEVICES
GPU_HELPER="${VITTA_GREETER_GPU_HELPER:-/usr/libexec/vitta/vitta-greeter-gpu}"
GPU_DEVICE=$("$GPU_HELPER" 2>/dev/null || true)
if [[ "$GPU_DEVICE" =~ ^/dev/dri/card[0-9]+$ ]]; then
    export WLR_DRM_DEVICES="$GPU_DEVICE"
fi

exec cage -d -s -m last -- quickshell -p /usr/share/vitta/greeter/shell.qml
