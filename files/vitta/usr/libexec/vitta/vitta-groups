#!/usr/bin/bash
# vitta-groups — give every wheel member access to Docker and libvirt.
#
# Replaces Bluefin's bluefin-dx-groups (no incus-admin: Vitta ships no Incus).
# Two fixes over that helper:
#   - it iterated "for user in $wheelarray", which expands to the FIRST array
#     element only; every wheel member is handled here;
#   - a group missing from both databases fails the run without writing the
#     state file, so the next boot retries instead of silently skipping.
#
# Why the /usr/lib/group step: RPM %pre groupadd during an image build lands in
# /usr/lib/group (nss-altfiles), which usermod cannot modify. Copy the entry
# into /etc/group first. Groups created at boot by systemd-sysusers (libvirt)
# are already in /etc/group and are left alone.
#
# Bump GROUPS_VERSION when the group list changes so existing installs re-run.
set -euo pipefail

GROUPS_VERSION=1
STATE_FILE=/etc/vitta/groups-version
TARGET_GROUPS=(docker libvirt)

if [[ -f "$STATE_FILE" && "$(<"$STATE_FILE")" == "$GROUPS_VERSION" ]]; then
  echo "vitta-groups: version $GROUPS_VERSION already applied"
  exit 0
fi

ensure_etc_group() {
  local group="$1" entry
  if grep -q "^${group}:" /etc/group; then
    return 0
  fi
  if ! entry=$(grep -m1 "^${group}:" /usr/lib/group); then
    echo "vitta-groups: group $group exists in neither /etc/group nor /usr/lib/group" >&2
    return 1
  fi
  echo "vitta-groups: copying $group from /usr/lib/group to /etc/group"
  printf '%s\n' "$entry" >>/etc/group
}

# Members are field 4 of the /etc/group wheel line, comma-separated.
IFS=',' read -r -a WHEEL_USERS <<<"$(awk -F: '$1 == "wheel" { print $4 }' /etc/group)"

failed=0
for group in "${TARGET_GROUPS[@]}"; do
  if ! ensure_etc_group "$group"; then
    failed=1
    continue
  fi
  for user in "${WHEEL_USERS[@]}"; do
    [[ -n "$user" ]] || continue
    echo "vitta-groups: adding $user to $group"
    usermod -aG "$group" "$user"
  done
done

if [[ "$failed" -ne 0 ]]; then
  echo "vitta-groups: incomplete, not recording version (retries next boot)" >&2
  exit 1
fi

mkdir -p "$(dirname "$STATE_FILE")"
printf '%s\n' "$GROUPS_VERSION" >"$STATE_FILE"
echo "vitta-groups: version $GROUPS_VERSION applied for: ${WHEEL_USERS[*]:-(no wheel members)}"
