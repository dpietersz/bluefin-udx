#!/usr/bin/python3
"""vitta-shadow-sync — give image system accounts a locked /etc/shadow entry.

Why: user@<uid>.service runs the systemd-user PAM stack, whose
`account ... pam_unix.so` fails with PAM_AUTHINFO_UNAVAIL ("Authentication
service cannot retrieve authentication info") for an account that has a
passwd entry with password `x` but no shadow entry. greetd's own user manager
(user@<greetd uid>) needs that entry.

On an ostree/bootc machine the account and its shadow entry can come apart:
- /etc is merged per file, and a locally modified /etc/shadow (every installed
  machine) is kept wholesale, so shadow entries a new image adds never arrive;
- rpm-ostree client-side layering moves the image's /etc/passwd system users
  (greetd, ...) into the deployment's /usr/lib/passwd, which nss-altfiles
  resolves, so systemd-sysusers sees greetd as existing and writes nothing.
A machine rebased onto Vitta with layered packages therefore has greetd in
/usr/lib/passwd and no shadow entry (T580 acceptance, 2026-11-07).

What: for every account in /usr/lib/passwd with password `x` that is neither
in /etc/passwd nor in /etc/shadow, append `name:!*:::::::` (locked, no
aging), the entry the image's own /etc/shadow carries for such accounts.
Existing lines are never touched. Takes the same lock as lckpwdf(3).
Ordered after systemd-sysusers.service (vitta-shadow-sync.service);
bootc-sysusers-shadow-sync.service removes the orphaned entries again if an
account later disappears.
"""
import fcntl
import os
import sys

IMAGE_PASSWD = "/usr/lib/passwd"
LOCAL_PASSWD = "/etc/passwd"
SHADOW = "/etc/shadow"
LOCK = "/etc/.pwd.lock"


def names(path, shadowed_only=False):
    try:
        with open(path, encoding="utf-8") as file:
            rows = [line.rstrip("\n").split(":") for line in file if line.strip()]
    except FileNotFoundError:
        return []
    return [row[0] for row in rows if not shadowed_only or (len(row) > 1 and row[1] == "x")]


def main():
    candidates = names(IMAGE_PASSWD, shadowed_only=True)
    if not candidates:
        return 0
    if not os.path.exists(SHADOW):
        print(f"vitta-shadow-sync: {SHADOW} missing; not creating it", file=sys.stderr)
        return 1
    lock = os.open(LOCK, os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        fcntl.lockf(lock, fcntl.LOCK_EX)
        local = set(names(LOCAL_PASSWD))
        with open(SHADOW, encoding="utf-8") as file:
            content = file.read()
        present = {line.split(":", 1)[0] for line in content.splitlines() if line}
        missing = [name for name in candidates if name not in local and name not in present]
        if not missing:
            return 0
        lines = "".join(f"{name}:!*:::::::\n" for name in missing)
        if content and not content.endswith("\n"):
            lines = "\n" + lines
        # Append in place: keeps the file's inode, mode 0000 and shadow_t label.
        shadow = os.open(SHADOW, os.O_WRONLY | os.O_APPEND | os.O_CLOEXEC)
        try:
            os.write(shadow, lines.encode())
            os.fsync(shadow)
        finally:
            os.close(shadow)
        print("vitta-shadow-sync: added locked shadow entries for: " + " ".join(missing))
        return 0
    finally:
        os.close(lock)


if __name__ == "__main__":
    sys.exit(main())
